{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@monitor/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules"]
}
