# Required in Zeabur. Paste the PostgreSQL connection string into the Zeabur
# service environment variables, not into source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional. Used by the reporter CLI when no --api-url flag is provided.
MONITOR_API_URL=http://localhost:3000

# Optional but recommended in production. Used to sign dashboard login cookies.
AUTH_SECRET=replace-with-a-long-random-string
